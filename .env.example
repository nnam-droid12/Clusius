# --- Database / queue (docker-compose defaults) ---
DATABASE_URL=postgresql+asyncpg://clusius:clusius@localhost:5432/clusius
REDIS_URL=redis://localhost:6379/0

# --- Target mode: SSH endpoints for an existing C4A + x86 pair. When both hosts are
# set, a launched run drives the full analyze->migrate->tune->benchmark->report
# pipeline for real over SSH; otherwise a run only performs the infra-free analyze
# stage (and a single-endpoint benchmark if target_base_url is given per-run). ---
CLUSIUS_TARGET_ARM_HOST=
CLUSIUS_TARGET_ARM_USER=clusius
CLUSIUS_TARGET_ARM_SSH_KEY_PATH=
# On-demand $/hr for your ARM instance type/region. The default below is the real,
# live c4a-standard-2 list price for us-central1, pulled from the Cloud Billing
# Catalog API (not guessed) — replace it if you're using a different instance type
# or region: `gcloud billing services list` -> Compute Engine -> skus, filter for
# "<type> Instance Core/Ram running in <your region's tier>".
CLUSIUS_TARGET_ARM_PRICE_PER_HOUR=0.0898
CLUSIUS_TARGET_ARM_INSTANCE_TYPE=c4a-standard-2

CLUSIUS_TARGET_X86_HOST=
CLUSIUS_TARGET_X86_USER=clusius
CLUSIUS_TARGET_X86_SSH_KEY_PATH=
# Same as above; default is the real c4-standard-2 list price for us-central1.
CLUSIUS_TARGET_X86_PRICE_PER_HOUR=0.0969
CLUSIUS_TARGET_X86_INSTANCE_TYPE=c4-standard-2

CLUSIUS_DEFAULT_HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# --- Provisioned mode (opt-in, disabled by default) ---
CLUSIUS_PROVISIONING_ENABLED=false
CLUSIUS_GCP_PROJECT_ID=
CLUSIUS_GCP_REGION=
CLUSIUS_GCP_CREDENTIALS_PATH=
CLUSIUS_COST_CEILING_USD=25
CLUSIUS_INSTANCE_TTL_MINUTES=120

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
