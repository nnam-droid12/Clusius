{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nnam-droid12/Clusius/bench/schema/result.schema.json",
  "title": "Clusius benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "commit_sha",
    "model",
    "model_hash",
    "backend",
    "quant",
    "instance_type",
    "arch",
    "price_per_hour",
    "threads",
    "concurrency",
    "throughput",
    "latency_ms",
    "cost_per_1m_tokens",
    "accuracy_score"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "commit_sha": { "type": "string" },
    "image_digest": { "type": "string" },
    "model": { "type": "string" },
    "model_hash": { "type": "string" },
    "backend": { "type": "string", "enum": ["llamacpp", "vllm"] },
    "quant": { "type": "string" },
    "instance_type": { "type": "string" },
    "arch": { "type": "string", "enum": ["x86_64", "aarch64"] },
    "price_per_hour": { "type": "number", "minimum": 0 },
    "threads": { "type": "integer", "minimum": 1 },
    "core_pinning": { "type": "boolean" },
    "batch_size": { "type": "integer", "minimum": 1 },
    "kv_cache_precision": { "type": "string", "enum": ["fp16", "int8"] },
    "context_length": { "type": "integer", "minimum": 1 },
    "concurrency": { "type": "integer", "minimum": 1 },
    "throughput": {
      "type": "object",
      "required": ["tokens_per_second", "requests_per_second"],
      "properties": {
        "tokens_per_second": { "type": "number", "minimum": 0 },
        "requests_per_second": { "type": "number", "minimum": 0 }
      }
    },
    "latency_ms": {
      "type": "object",
      "required": ["ttft_p50", "p50", "p95", "p99"],
      "properties": {
        "ttft_p50": { "type": "number", "minimum": 0 },
        "inter_token_p50": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 }
      }
    },
    "cost_per_1m_tokens": { "type": "number", "minimum": 0 },
    "accuracy_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "baseline_ref": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
